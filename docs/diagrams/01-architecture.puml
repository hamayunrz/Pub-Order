@startuml
title Pub-Order Architecture — First Draft
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
actor Student
actor "Kitchen Staff" as Staff
component "Website\nStudent and kitchen pages" as Website
component "Backend (FastAPI)\nMenu, cart, orders, and stock" as Backend
component "Supabase Auth\nLogin and accounts" as Auth
database "Supabase Database\nMenu items and orders" as DB
Student --> Website : uses
Staff --> Website : uses
Website --> Backend : sends requests
Website --> Auth : signs in
Backend --> Auth : checks login
Backend --> DB : reads / saves data
@enduml
