@startuml
title Pub-Order Classes — First Draft
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam nodesep 100
skinparam ranksep 100
skinparam linetype polyline
hide circle
hide empty methods
class User {
  name: String
  email: String
  role: String
}
class Cart {
  cartId: String
}
class CartItem {
  quantity: Integer
  customization: String
}
class MenuItem {
  name: String
  price: Decimal
  category: String
  stock: Integer
}
class Order {
  orderId: String
  status: String
  total: Decimal
}
class OrderItem {
  quantity: Integer
  priceAtOrder: Decimal
  customization: String
}
User "1" -- "\n0..1" Cart : has
User "1" -- "0..*" Order : places
Cart "1" -- "0..*" CartItem : contains
Order "1" -- "1..*" OrderItem : contains
CartItem "0..*" -- "1" MenuItem : refers to
OrderItem "0..*" -- "1" MenuItem : refers to
@enduml
