@startuml
title Pub-Order Backend — Component Diagram
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam componentStyle uml2

component "Web client" as Client

package "Backend API (FastAPI)" {
  component "API routes\n(main.py)\nGET /me" as Routes
  component "Auth check\n(auth.py)" as Auth
  component "Settings\n(config.py)" as Config
}

file ".env" as Env
cloud "Supabase Auth" as SupabaseAuth

Client --> Routes : HTTP + Bearer token
Routes --> Auth : get_current_user
Auth --> SupabaseAuth : verify token
Auth --> Config : Supabase URL / key
Config --> Env : reads
@enduml
