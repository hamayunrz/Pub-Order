@startuml
title
  Pub-Order CI/CD Pipeline (GitHub Actions: tests.yml)
  Runs on every pull request and every push to main
end title
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam rectangleRoundCorner 10
skinparam nodesep 55
skinparam ranksep 45
skinparam packageStyle rectangle

package "backend job" {
  rectangle "Install\n(pinned\nrequirements)" as B1
  rectangle "Lint\n(ruff)" as B2
  rectangle "Type check\n(mypy)" as B3
  rectangle "Unit tests\n(pytest)" as B4
  rectangle "Integration tests\n(local Supabase:\nAPI → auth → DB,\nSQL checks)" as B5
  rectangle "Coverage\nreport\n(≥ 70%)" as B6
}

package "frontend job" {
  rectangle "Install\n(package-\nlock.json)" as F1
  rectangle "Lint\n(ESLint)" as F2
  rectangle "Type check\n(n/a: plain JS)" as F3
  rectangle "Unit tests\n(Vitest)" as F4
  rectangle "Integration tests\n(Vitest)" as F5
  rectangle "Coverage\nreport\n(≥ 70%)" as F6
}

rectangle "<b>e2e job</b>\n\nBrowser tests\n(Playwright)\nbrowser → Vite →\nFastAPI → Supabase" as E1

rectangle "<b>deliver job</b>\nonly on push to main\nor a sprint3 tag\n\nbuild frontend,\npackage versioned zip,\nsmoke-test it,\npublish artifact\n(+ Release on tag)" as D1

B1 --> B2
B2 --> B3
B3 --> B4
B4 --> B5
B5 --> B6
F1 --> F2
F2 --> F3
F3 --> F4
F4 --> F5
F5 --> F6
B6 --> E1
F6 --> E1
F6 -[hidden]-> D1
E1 -[norank]-> D1

legend bottom
  Each job's steps run in order and stop at the first failure; unit and integration tests are separate steps.
  backend, frontend and e2e are required checks on main, so a red check blocks the merge.
  deliver runs only after every test job passes; on pull requests it is skipped.
  Integration and E2E tests use a throwaway local Supabase, never the hosted project.
  Coverage gate: 70% of branches on both sides (the spec's minimum is 50%).
  deliver output: pub-order-0.3.<run>-<commit>.zip, kept 90 days; a sprint3 tag also creates a GitHub Release.
endlegend
@enduml
