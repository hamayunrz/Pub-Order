@startuml
title Pub-Order Frontend — Component Diagram
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam componentStyle uml2

package "Web client (React)" {
  component "App\n(page switching)" as App
  component "Login" as Login
  component "Menu" as Menu
  component "Cart logic\n(cart.js)" as Cart
  component "Menu data\n(menu-data.js)" as MenuData
  component "Supabase client\n(supabase.js)" as SupaClient
}

database "Browser\nlocalStorage" as Storage
cloud "Supabase Auth" as SupabaseAuth
component "Backend API" as Backend

App --> Login : shows
App --> Menu : shows
Login --> SupaClient : sign in / sign up
SupaClient --> SupabaseAuth
Login --> Backend : GET /api/me
Menu --> Cart : update cart
Menu --> MenuData : items, photos
Cart --> MenuData : prices, swipe types
Menu --> Storage : save / restore cart
@enduml
